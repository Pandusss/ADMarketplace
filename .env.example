# ──────────────────────────────────────────────────────────────
# AdMarketplace — .env
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────
ENVIRONMENT=local

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/admarketplace

# ── Telegram Bot API ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_ID=123456789

# ── MTProto / Telethon ────────────────────────────────────────
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your-api-hash-here
TELEGRAM_USER_SESSION=your-string-session-here

# ── TON (escrow) ──────────────────────────────────────────────
TON_ENABLED=true
TON_NETWORK=mainnet
TON_MNEMONIC=word1 word2 ... word24
TON_API_URL=https://tonapi.io/v2
TON_API_KEY=your-tonapi-key-here
TON_COMMISSION_WALLET=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Frontend / Webhooks ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5002
